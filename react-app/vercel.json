{
  "redirects": [
    { "source": "/step-by-step-guide-filing-form-990-for-the-first-time", "destination": "/services/tax-services", "permanent": true },
    { "source": "/business-meals-gifts-and-client-entertainment", "destination": "/services/tax-services", "permanent": true },
    { "source": "/fremont-business-license", "destination": "/services/consulting", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!api|_next|favicon\\.ico|.*\\.).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
