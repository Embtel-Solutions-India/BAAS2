# Audit item A11: duplicate URL variants.
#
# Live check (23 Oct 2026): http:// and www. already redirect with a 301, but these return 200 with the same page:
#   https://bayareaaccountingsolutions.com/about/        (trailing slash)
#   https://bayareaaccountingsolutions.com/index.html
# Search engines may index them as duplicates. The page canonical tags already point at the clean URL, so this is a
# tidy-up, not an emergency.
#
# This is NOT applied by the app or the deploy workflow: nginx is configured on the server, outside this repo.
# Add the two rules below inside the existing HTTPS `server { ... }` block, ABOVE the location block that falls back
# to index.html, then test BEFORE reloading nginx for real:
#
#   sudo nginx -t
#   curl -sI https://bayareaaccountingsolutions.com/about/      # expect: 301 -> /about
#   curl -sI https://bayareaaccountingsolutions.com/index.html  # expect: 301 -> /
#   curl -sI https://bayareaaccountingsolutions.com/about       # expect: 200 (unchanged)
#   curl -sI https://bayareaaccountingsolutions.com/            # expect: 200 (unchanged)
#
# Untested against your real configuration: check it on a copy first.

# /index.html -> /
location = /index.html {
    return 301 /;
}

# /anything/ -> /anything   (keeps the query string; leaves "/" alone)
rewrite ^/(.+)/$ /$1 permanent;
